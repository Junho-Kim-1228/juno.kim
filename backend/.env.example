# Django settings module used by management commands or the application server.
DJANGO_SETTINGS_MODULE=

# Strong, unique Django secret key. Never reuse the Discord Bot token.
SECRET_KEY=

# Use True only on a local development machine.
DEBUG=

# Comma-separated host names accepted by Django.
ALLOWED_HOSTS=

# Django database URL. Use a dedicated MySQL user with minimum privileges.
DATABASE_URL=

# Optional isolated database URL used only by automated tests.
TEST_DATABASE_URL=

# Local Docker MySQL database name and least-privilege application account.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Local container administration only. Never reuse this value in production.
MYSQL_ROOT_PASSWORD=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=

# Comma-separated HTTPS origins trusted for CSRF protection.
CSRF_TRUSTED_ORIGINS=

# HttpOnly refresh-token cookie name. The application sets Secure in production.
JWT_REFRESH_COOKIE_NAME=

# Optional non-default Django admin path. This is defense-in-depth, not authentication.
ADMIN_URL=

# Redirect plain HTTP requests to HTTPS in production.
SECURE_SSL_REDIRECT=

# Keep this at 0 until HTTPS has been verified, then raise it gradually.
SECURE_HSTS_SECONDS=

# Enable only after all subdomains are permanently HTTPS-ready.
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
